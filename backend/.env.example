# =============================================================================
# REQUIRED to boot the app
# =============================================================================
# Supabase project URL and service_role key (Project Settings -> API).
# Use the service_role key, NOT the public anon key -- this backend writes
# on the customer's behalf and must bypass row-level security.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Direct Postgres connection string (Project Settings -> Database ->
# Connection string -> URI, "Session pooler" or direct connection both work).
# Enables: the SQL query tool in the UI, and automatic schema.sql apply on
# first boot. If omitted, run backend/app/schema.sql manually once in the
# Supabase SQL editor and the SQL query tool stays disabled.
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# =============================================================================
# Auth
# =============================================================================
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=720

# Bootstrap admin account, created automatically on first startup if the
# app_users table is empty. Log in and change the password immediately.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Key used to encrypt SMTP/IMAP passwords and API keys saved from the
# Settings page before they're stored in the database. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank, a key is generated in-memory each boot (fine for local
# dev, but saved secrets won't survive a restart) -- set this in production.
SETTINGS_ENCRYPTION_KEY=

# =============================================================================
# OPTIONAL fallbacks -- everything below can instead be entered from the
# Settings page in the UI once you're logged in. Values entered in the UI
# always take precedence over these; these are only used if the UI hasn't
# been configured yet. Leave any of these blank to require UI configuration.
# =============================================================================

# LLM (OpenAI-compatible endpoint -- defaults to Gemini's OpenAI-compat API).
# Paste a Google AI Studio API key here for LLM_API_KEY, or leave blank and
# enter it as "Google API key" on the Settings page instead.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# Outbound email (follow-up requests to claimants). Use an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Inbound email (claim intake mailbox).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# Business thresholds -- also editable at runtime from Settings.
AUTO_APPROVE_PAYOUT_LIMIT=1500.0
RISK_SCORE_ESCALATE_THRESHOLD=0.3
MAX_FOLLOWUP_ATTEMPTS=3
POLL_INTERVAL_SECONDS=60
POLLING_ENABLED_ON_BOOT=false

# Comma-separated list of allowed frontend origins, or * for any.
CORS_ORIGINS=*
